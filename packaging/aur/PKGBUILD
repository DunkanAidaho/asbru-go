# Maintainer: Dunkan Aidaho <dacent211@yandex.ru>
# Installs the binary as asbru-go, so it can coexist with asbru-cm. Both
# applications share ~/.config/asbru for configuration compatibility.
pkgname=asbru-go
pkgver=0.1.1
pkgrel=1
pkgdesc="Ásbrú Connection Manager — Go/Qt6 rewrite of the GTK/Perl connection manager"
arch=('x86_64' 'aarch64')
url="https://github.com/DunkanAidaho/asbru-go"
license=('GPL-3.0-or-later')
depends=('glibc' 'gcc-libs' 'qt6-base' 'qtermwidget' 'freerdp' 'libvncserver' 'hicolor-icon-theme')
makedepends=('go' 'gcc' 'pkgconf' 'qt6-tools')
optdepends=(
  'openssh: SSH and SFTP sessions'
  'mosh: MOSH sessions'
  'tigervnc: external VNC viewer'
  'rdesktop: external RDP viewer'
  'xdg-utils: open screenshots with an external viewer'
)
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz"
        'asbru-go.desktop')
sha256sums=('8fbacd1784b03f697c2af959deebd612fa2db47980cda71d467f1ca51fd2d27b'
            'fea83e57db0edea90b3dee3c41c0ee1b8a940dd7725408363a73b676ae6f8dda')

build() {
  cd "$pkgname-$pkgver"
  mkdir -p "$srcdir/gocache" "$srcdir/gotmp"
  export GOCACHE="$srcdir/gocache"
  export GOTMPDIR="$srcdir/gotmp"
  go build -buildmode=pie -trimpath \
    -ldflags '-s -w -linkmode=external -extldflags "-Wl,-z,relro,-z,now"' \
    -o asbru-go ./cmd/asbru
  make i18n LRELEASE=lrelease6
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 asbru-go "$pkgdir/usr/bin/asbru-go"
  install -Dm644 "$srcdir/asbru-go.desktop" "$pkgdir/usr/share/applications/asbru-go.desktop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"

  local s
  for s in 16 24 32 48 64 128 256 512; do
    install -Dm644 "internal/ui/assets/asbru-icon-$s.png" \
      "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/asbru-go.png"
  done

  install -Dm644 i18n/asbru_ru.qm "$pkgdir/usr/share/asbru/i18n/asbru_ru.qm"
}
